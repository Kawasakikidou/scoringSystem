# 编译产物
out/
# 数据库文件（H2 单文件库 + 锁/日志）
data/*.mv.db
data/*.trace.db
data/*.lock.db
# 导出与备份
data/*.csv
*.csv
# 临时文件
*.tmp
# JavaFX SDK（体积大，由 scripts/fetch-gui-libs.sh(.bat) 按需下载）
lib/openjfx-17/
# 打包用临时输入目录（jpackage 输入 staging，不入库）
dist-pkg/
# Windows 安装产物（ScoringGUI-*.exe / Setup 壳），发 GitHub Release 附件，不入库
dist/
# WiX 工具集（由 scripts/package-win.bat 自动下载到 lib\wix3）
lib/wix3/
# Python 虚拟环境（装配 venv 用；acceptance/self-test 自动优先使用）
.venv/
